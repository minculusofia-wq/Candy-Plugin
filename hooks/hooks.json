{
  "description": "Garde-fous : rappels au démarrage, contrôles avant écriture et avant push, relecture en fin de tour.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cat | bash \"${CLAUDE_PLUGIN_ROOT}/hooks/ouverture-de-phase.sh\"'"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cat | python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/jeu-de-documents.sh\" --hook || echo \"{\\\"systemMessage\\\": \\\"⚠️ jeu-de-documents.sh a planté : contrôle du jeu de documents HORS SERVICE\\\"}\"'"
          },
          {
            "type": "command",
            "command": "bash -c 'cat | bash \"${CLAUDE_PLUGIN_ROOT}/hooks/rappel-projet.sh\"'"
          },
          {
            "type": "command",
            "command": "bash -c 'cat | bash \"${CLAUDE_PLUGIN_ROOT}/hooks/rappel-entretien.sh\"'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cat | bash \"${CLAUDE_PLUGIN_ROOT}/hooks/rule13-source-or-silence.sh\"'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'INPUT=$(cat); CMD=$(printf \"%s\" \"$INPUT\" | python3 -I -c \"import sys,json; sys.stdout.reconfigure(errors=\\\"replace\\\"); d=json.loads(sys.stdin.buffer.read().decode(\\\"utf-8\\\",\\\"replace\\\")); t=d.get(\\\"tool_input\\\") if isinstance(d,dict) else None; print((t if isinstance(t,dict) else {}).get(\\\"command\\\") or \\\"\\\")\" 2>/dev/null); if [[ \"$CMD\" == *\"git push\"* ]]; then bash \"${CLAUDE_PLUGIN_ROOT}/hooks/validate-before-push.sh\"; fi'"
          },
          {
            "type": "command",
            "command": "bash -c 'cat | bash \"${CLAUDE_PLUGIN_ROOT}/hooks/rule12-phase-debug-required.sh\"'"
          },
          {
            "type": "command",
            "command": "bash -c 'cat | bash \"${CLAUDE_PLUGIN_ROOT}/hooks/protect-secrets.sh\"'"
          }
        ]
      },
      {
        "matcher": "Write|Edit|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cat | bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-edit-guard.sh\"'"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cat | bash \"${CLAUDE_PLUGIN_ROOT}/hooks/protect-secrets.sh\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cat | bash \"${CLAUDE_PLUGIN_ROOT}/hooks/controle-si-code-modifie.sh\"'"
          },
          {
            "type": "command",
            "command": "bash -c 'cat | python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/relire-ma-reponse.sh\"'"
          }
        ]
      }
    ]
  }
}
