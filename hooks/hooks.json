{
  "description": "Garde-fous : rappels au démarrage, contrôles avant écriture et avant push, relecture en fin de tour.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cat | bash \"${CLAUDE_PLUGIN_ROOT}/hooks/ouverture-de-phase.sh\"'"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cat | bash \"${CLAUDE_PLUGIN_ROOT}/hooks/taille-claude-md.sh\"'"
          },
          {
            "type": "command",
            "command": "bash -c 'cat | bash \"${CLAUDE_PLUGIN_ROOT}/hooks/rappel-projet.sh\"'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cat | bash \"${CLAUDE_PLUGIN_ROOT}/hooks/rule13-source-or-silence.sh\"'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'INPUT=$(cat); CMD=$(printf \"%s\" \"$INPUT\" | python3 -c \"import sys,json; print(json.load(sys.stdin).get(\\\"tool_input\\\",{}).get(\\\"command\\\",\\\"\\\"))\" 2>/dev/null); if [[ \"$CMD\" == *\"git push\"* ]]; then bash \"${CLAUDE_PLUGIN_ROOT}/hooks/validate-before-push.sh\"; fi'"
          },
          {
            "type": "command",
            "command": "bash -c 'cat | bash \"${CLAUDE_PLUGIN_ROOT}/hooks/rule12-phase-debug-required.sh\"'"
          },
          {
            "type": "command",
            "command": "bash -c 'cat | bash \"${CLAUDE_PLUGIN_ROOT}/hooks/protect-secrets.sh\"'"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cat | bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-edit-guard.sh\"'"
          },
          {
            "type": "command",
            "command": "bash -c 'cat | bash \"${CLAUDE_PLUGIN_ROOT}/hooks/protect-secrets.sh\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cat | bash \"${CLAUDE_PLUGIN_ROOT}/hooks/controle-si-code-modifie.sh\"'"
          },
          {
            "type": "command",
            "command": "bash -c 'cat | python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/relire-ma-reponse.sh\"'"
          }
        ]
      }
    ]
  }
}
